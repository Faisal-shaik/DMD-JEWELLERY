{
  "name": "dmd-jewellery",
  "version": "1.0.0",
  "description": "Complete full-stack website and secure admin panel for DMD Jewellery",
  "main": "backend/server.js",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node backend/server.js",
    "create-admin": "node backend/scripts/create-admin.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  },
  "keywords": [
    "jewellery",
    "catalogue",
    "fullstack",
    "admin-panel",
    "express",
    "react",
    "sqlite"
  ],
  "author": "DMD Jewellery",
  "license": "MIT"
}
