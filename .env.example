# DMD JEWELLERY ENVIRONMENT CONFIGURATION TEMPLATE

# Server Settings
PORT=5000
NODE_ENV=production

# Persistent Database Settings (Supabase PostgreSQL / Cloud Database)
DB_TYPE=postgres
DATABASE_URL=postgresql://user:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SQLITE_DB_PATH=./database/dmd_jewellery.sqlite

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here

# Admin Setup Configuration
ADMIN_EMAIL=admin@dmdjewellery.com

# Optional Frontend API URL (for decoupled hosting)
VITE_API_URL=

# Cloud Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
