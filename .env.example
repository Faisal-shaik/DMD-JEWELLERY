# DMD JEWELLERY ENVIRONMENT CONFIGURATION TEMPLATE

# Server Settings
PORT=5000
NODE_ENV=production

# Database Settings (SQLite File Database - 100% Free Hosting)
DB_TYPE=sqlite
SQLITE_DB_PATH=./database/dmd_jewellery.sqlite

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here

# Admin Setup Configuration
ADMIN_EMAIL=admin@dmdjewellery.com

# Optional Frontend API URL (for decoupled hosting)
VITE_API_URL=

# Optional Cloud Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
