# DMD JEWELLERY ENVIRONMENT CONFIGURATION

# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings
# Set DB_TYPE to 'sqlite' for zero-config local run or 'mysql' for production MySQL
DB_TYPE=sqlite
DB_FILE=./database/dmd_jewellery.sqlite

# MySQL Database Settings (when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dmd_jewellery
DB_USER=root
DB_PASSWORD=

# Security & Authentication
JWT_SECRET=dmd_jewellery_jwt_secret_key_change_in_production_2026

# Admin Setup Configuration
ADMIN_EMAIL=admin@dmdjewellery.com

# Optional Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
